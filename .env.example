# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Kredensial admin (diverifikasi di server)
ADMIN_USER=disnaker
ADMIN_PASSWORD=ganti-password-anda

# Kunci rahasia untuk cookie sesi (buat string acak panjang, mis. via `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Port server
PORT=3000

# Konfigurasi Database MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jadwal_mediasi
